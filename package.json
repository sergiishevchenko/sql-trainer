{
  "name": "sql-mastery",
  "productName": "SQL Mastery",
  "version": "1.0.0",
  "description": "Desktop SQL learning platform: interactive exercises, real SQL execution, progress tracking.",
  "main": "./out/main/index.js",
  "author": "SQL Mastery",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && electron-builder --config electron-builder.yml",
    "build:app": "electron-vite build",
    "build:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "build:win": "electron-vite build && electron-builder --config electron-builder.yml --win",
    "build:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac",
    "build:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:content": "vitest run tests/integration/content.test.ts",
    "test:e2e": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "content:report": "vite-node scripts/content-report.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "hash-wasm": "^4.12.0",
    "sql.js": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.55.0",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.80.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "framer-motion": "^12.18.0",
    "lucide-react": "^0.525.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router": "^7.6.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.5",
    "sql-formatter": "^15.6.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^3.2.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.5"
  }
}
